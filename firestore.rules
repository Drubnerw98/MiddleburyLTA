rules_version = '2';

// All writes are now performed server-side via the Admin SDK (which
// bypasses these rules) from server actions that validate input with
// Zod and re-check the admin claim. Client writes are denied across
// the board as a safety net. Reads remain public on the surfaces the
// public site needs.

service cloud.firestore {
  match /databases/{database}/documents {

    // Public-facing posts and their comments. Reads are open; all
    // writes flow through server actions in src/app/actions/.
    match /posts/{postId} {
      allow read: if true;
      allow write: if false;

      match /comments/{commentId} {
        allow read: if true;
        allow write: if false;
      }
    }

    // Curated external links (Articles & Links page). Reads public,
    // writes through adminLinkActions.ts only.
    match /external_links/{linkId} {
      allow read: if true;
      allow write: if false;
    }

    // Editable About copy. Reads public so AboutEditor can prefill,
    // writes through adminAboutAction.ts.
    match /pages/{pageId} {
      allow read: if true;
      allow write: if false;
    }

    // Admin settings (e.g. emailNotifications toggle). Reads public
    // because surfaces need to know the toggle state; writes through
    // adminSettingsAction.ts.
    match /admin/{docId} {
      allow read: if true;
      allow write: if false;
    }

    // Default deny — anything not explicitly matched above is locked.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
